// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum ImportStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum UserRole {
  USER
  ADMIN
}

enum OrganizationEntityType {
  NONPROFIT_501C3
  NONPROFIT_OTHER
  FISCAL_SPONSOR
  GOVERNMENT
  TRIBE
  SCHOOL
  FOR_PROFIT
  INDIVIDUAL
  OTHER
}

enum RevenueSource {
  DONATIONS
  GRANTS
  GOV_CONTRACTS
  PROGRAM_FEES
  MEMBERSHIPS
  CORPORATE_SPONSORS
  OTHER
}

enum BudgetRange {
  LT_50K
  FROM_50K_TO_250K
  FROM_250K_TO_1M
  FROM_1M_TO_5M
  OVER_5M
}

enum StaffRange {
  ZERO
  ONE_TO_FIVE
  SIX_TO_TWENTY
  TWENTY_ONE_TO_ONE_HUNDRED
  OVER_ONE_HUNDRED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

enum GrantDeadlineType {
  CLOSED
  FIXED
  ONGOING
  ROLLING
  TBD
  UNKNOWN
}

enum GrantOpenDateType {
  CLOSED
  FIXED
  ONGOING
  ROLLING
  TBD
  UNKNOWN
}

enum GrantSource {
  CALIFORNIA
  FEDERAL
  OHIO
  OTHER
}

enum GrantStatus {
  OPEN
  CLOSED
  UNKNOWN
}

enum GrantDetailsStatus {
  UNKNOWN
  FETCHING
  AVAILABLE
  FAILED
}

enum BookmarkStatus {
  INTERESTED
  APPLIED
  NOT_FOR_US
}

enum MatchIndexStatus {
  NOT_STARTED
  RUNNING
  COMPLETE
  FAILED
}

model Grant {
  id                    String       @id @default(cuid())
  url                   String
  title                 String
  number                String?        // For Federal grant numbers (unique per source)
  deadline              DateTime?
  deadlineType          GrantDeadlineType?
  openDate              DateTime?
  openDateType          GrantOpenDateType?
  stateAgency           String?
  matchFunding          String?
  estimatedTotalFunding BigInt?
  awardFloor            BigInt?      // For Federal grants
  awardCeiling          BigInt?      // For Federal grants
  estimatedAwardAmounts String?
  fundsDisbursment      String?
  currentAsOf           DateTime?
  grantor               String
  portalId              Int?           // Made optional since Federal uses different ID system
  opportunityType       String?
  purpose               String?
  eligibleApplicants    String?
  eligibleGeographies   String?
  details               GrantDetail?
  detailsStatus         GrantDetailsStatus @default(UNKNOWN)
  detailsFetchedAt      DateTime?
  detailsError          String?            @db.VarChar(500)
  detailsErrorAt        DateTime?
  attachments           GrantAttachment[]
  source                GrantSource   @default(CALIFORNIA)
  agencyCode            String?       // For Federal grants
  cfdaList              Json?         @db.JsonB  // For Federal grants
  sourceRecordId        String?       // upstream id (string)
  sourceKey             String?       // deterministic hash if no sourceRecordId
  contentHash           String?       // hash of meaningful fields
  fitScore              Float?
  fitScoreVersion       Int           @default(1)
  fitScoreComputedAt    DateTime?
  lastSeenAt            DateTime?
  status                GrantStatus   @default(UNKNOWN)
  closedAt              DateTime?
  changes               GrantChange[]
  bookmarks             GrantBookmark[]
  grantMatches          GrantMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, number])
  @@unique([source, sourceRecordId])
  @@unique([source, sourceKey])
  @@index([fitScore])
}

model GrantDetail {
  id                      String @id @default(cuid())
  title                   String?
  purpose                 String?
  description             String?
  eligibilityRequirements Json?   @db.JsonB
  fundingDetails          Json?   @db.JsonB
  synopsisHtml            String? @db.Text
  applicantEligibilityDesc String? @db.Text
  fundingDescLinkUrl      String?
  responseDateDesc        String? @db.Text
  rawJson                 Json?   @db.JsonB
  fetchedAt               DateTime?
  grantId                 String @unique
  grant                   Grant  @relation(fields: [grantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GrantAttachment {
  id          String   @id @default(cuid())
  grantId     String
  grant       Grant    @relation(fields: [grantId], references: [id], onDelete: Cascade)
  upstreamId  String?
  fileName    String
  mimeType    String?
  description String?
  url         String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())

  @@index([grantId])
  @@unique([grantId, upstreamId])
}

model GrantImportRun {
  id                String       @id @default(cuid())
  dateStart         DateTime
  dateEnd           DateTime
  status            ImportStatus @default(QUEUED)
  errorMessage      String?
  requestedBy       User         @relation(fields: [requestedByUserId], references: [id])
  requestedByUserId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String           @id @default(cuid())
  firstName       String?
  lastName        String?
  email           String?          @unique
  phone           String?
  password        String?          @db.Text
  emailVerified   DateTime?
  image           String?
  role            UserRole         @default(USER)
  organizationId  String?
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  accounts        Account[]
  sessions        Session[]
  grantBookmarks  GrantBookmark[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  grantImportRuns GrantImportRun[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id                String       @id @default(uuid())
  name              String
  description       String?      @db.Text
  mission           String       @db.Text
  focusAreas        String[]                  @default([])
  priorityFocusKeywords String[]              @default([])
  serviceAreas      String[]                  @default([])
  entityType        OrganizationEntityType?
  revenueSources    RevenueSource[]           @default([])
  budgetRange       BudgetRange?
  staffRange        StaffRange?
  preferredAwardMin Int?
  preferredAwardMax Int?
  scoringVersion    Int                       @default(4)
  matchIndexStatus  MatchIndexStatus          @default(NOT_STARTED)
  matchIndexedAt    DateTime?
  matchIndexedCount Int                       @default(0)
  matchIndexError   String?
  matchIndexCursor     String?
  matchIndexClaimId    String?
  matchIndexClaimedAt  DateTime?
  matchIndexErrorJson  Json?                  @db.JsonB
  address1          String
  address2          String?
  city              String
  state             String
  zipCode           String
  users             User[]
  invitations       Invitation[]
  grantMatches      GrantMatch[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([matchIndexStatus])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  status         InvitationStatus @default(PENDING)
  organization   Organization     @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([email, organizationId])
}

model GrantSyncRun {
  id              String       @id @default(cuid())
  source          GrantSource
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  status          ImportStatus @default(IN_PROGRESS)

  recordsFetched  Int          @default(0)
  createdCount    Int          @default(0)
  updatedCount    Int          @default(0)
  unchangedCount  Int          @default(0)
  closedCount     Int          @default(0)
  reopenedCount   Int          @default(0)

  errorsJson      Json?        @db.JsonB
  schemaJson      Json?        @db.JsonB
  changes         GrantChange[]
}

model GrantChange {
  id         String   @id @default(cuid())
  grantId    String
  runId      String
  changeType String   // CREATED/UPDATED/CLOSED/REOPENED/STATUS_CHANGED
  oldHash    String?
  newHash    String?
  diffJson   Json?    @db.JsonB
  observedAt DateTime @default(now())

  grant Grant        @relation(fields: [grantId], references: [id], onDelete: Cascade)
  run   GrantSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([grantId, observedAt])
  @@index([runId])
}

model GrantBookmark {
  id        String          @id @default(cuid())
  userId    String
  grantId   String
  status    BookmarkStatus  @default(INTERESTED)
  note      String?         @db.Text
  tags      String[]        @default([])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant Grant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@unique([userId, grantId])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([grantId])
}

model GrantMatch {
  id             String   @id @default(cuid())
  organizationId String
  grantId        String
  fitScore       Float
  version        Int
  computedAt     DateTime @default(now())
  subscoresJson  Json?    @db.JsonB
  explanation    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grant         Grant         @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@unique([organizationId, grantId])
  @@index([organizationId, fitScore])
  @@index([organizationId, grantId])
}
